{
    "name": "mcaskill/charcoal-support",
    "description": "Support package for Charcoal.",
    "type": "library",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/mcaskill/charcoal-support/issues",
        "source": "https://github.com/mcaskill/charcoal-support"
    },
    "authors": [
        {
            "name": "Chauncey McAskill",
            "email": "chauncey@locomotive.ca"
        },
        {
            "name": "Locomotive",
            "homepage": "https://locomotive.ca"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.15.x-dev"
        }
    },
    "require": {
        "php": "^7.4 || ^8.3",
        "ext-mbstring": "*",
        "charcoal/charcoal": "^5.0",
        "mustache/mustache": "^3.2",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.13 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Charcoal\\Support\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Charcoal\\Tests\\Support\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@tests"
        ],
        "tests": [
            "@phplint",
            "@phpcs",
            "@phpunit"
        ],
        "phplint": "find src/ tests/ -type f -name '*.php' -print0 | xargs -0 -n1 -P8 php -l | grep -v '^No syntax errors detected'; test $? -eq 1",
        "phpunit": "php vendor/bin/phpunit --coverage-text",
        "phpcs": "php vendor/bin/phpcs -ps --colors --standard=phpcs.xml.dist src/",
        "phpcbf": "php vendor/bin/phpcbf -ps --colors --standard=phpcs.xml.dist src/ tests/"
    }
}
